{
  "description": "My Business Brain: a short brief at session start (decisions waiting, contract deadlines, health) and a quick health check after a brain entry is written. Claude Code and Cowork only; on claude.ai the skills do the same by instruction.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/session_brief.py\" 2>/dev/null || python \"${CLAUDE_PLUGIN_ROOT}/hooks/session_brief.py\" 2>/dev/null || true",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/after_write.py\" 2>/dev/null || python \"${CLAUDE_PLUGIN_ROOT}/hooks/after_write.py\" 2>/dev/null || true",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
